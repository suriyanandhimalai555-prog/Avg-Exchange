PORT=4000
NODE_ENV=development

# JWT secret - use a long random string in production (e.g. openssl rand -hex 64)
SECRET=your-strong-jwt-secret-here

# PostgreSQL connection string (Supabase or self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/database

# CoinMarketCap API key - https://coinmarketcap.com/api/
COINMARKETCAP_API=your-coinmarketcap-api-key

# 1inch API key - https://portal.1inch.dev/
ONE_INCH_API_KEY=your-1inch-api-key

# CoinGecko API key (demo or pro) - https://www.coingecko.com/api/
COINGECKO_API_KEY=your-coingecko-api-key

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,https://avg-exchange.vercel.app,https://www.avgexchange.io,https://avgexchange.io

# ── Market-maker bot integration ────────────────────────────────────────────
# Email of the dedicated bot account (created by `node bot/setup.js`).
# When set, the server cancels ALL open bot orders on every startup so stale
# liquidity never pollutes the order book when the bot is offline.
# Must match BOT_EMAIL in bot/.env exactly.
BOT_EMAIL=bot@avgexchange.io
