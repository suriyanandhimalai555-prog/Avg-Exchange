# Exchange backend URL
API_URL=http://localhost:4000

# Bot's exchange account (create via /signup first)
BOT_EMAIL=bot@avgexchange.io
BOT_PASSWORD=BotPass@1234!

# Trading pair
BOT_PAIR=BTC/USDT

# Market maker strategy
BOT_SPREAD_PCT=0.3          # spread on each side in % (0.3 = 0.3% above/below mid)
BOT_ORDER_SIZE=0.001        # BTC per level
BOT_LEVELS=3                # how many price levels to quote on each side
BOT_LEVEL_STEP_PCT=0.1      # extra % gap between each level (0.1 = 0.1% per step)
BOT_INTERVAL_MS=30000       # refresh cycle in milliseconds (30 seconds)
